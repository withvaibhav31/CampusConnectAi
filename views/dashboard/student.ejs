<%- include('../partials/header') %>

<div class="page-container">
  <!-- Dashboard Header -->
  <div class="dashboard-header">
    <div class="dashboard-welcome">
      <div class="welcome-avatar"><%= currentUser.name.charAt(0).toUpperCase() %></div>
      <div>
        <h1>Welcome back, <span class="accent"><%= currentUser.name.split(' ')[0] %></span>! 👋</h1>
        <p>Here's your personalized campus overview</p>
      </div>
    </div>
    <div class="dashboard-quick-actions">
      <a href="/events" class="btn-secondary">Browse Events</a>
      <a href="/registrations/my" class="btn-primary">My Registrations</a>
    </div>
  </div>

  <!-- Stats Row -->
  <div class="stats-row">
    <div class="stat-card">
      <span class="stat-icon">📅</span>
      <div>
        <strong><%= totalRegistrations %></strong>
        <span>Total Registrations</span>
      </div>
    </div>
    <div class="stat-card">
      <span class="stat-icon">⏳</span>
      <div>
        <strong><%= myRegistrations.length %></strong>
        <span>Upcoming Events</span>
      </div>
    </div>
    <div class="stat-card">
      <span class="stat-icon">🎯</span>
      <div>
        <strong><%= currentUser.interests ? currentUser.interests.length : 0 %></strong>
        <span>Interest Areas</span>
      </div>
    </div>
    <div class="stat-card">
      <span class="stat-icon">🤖</span>
      <div>
        <strong><%= recommendedEvents.length %></strong>
        <span>AI Recommendations</span>
      </div>
    </div>
  </div>

  <!-- Notifications -->
  <% if (notifications && notifications.length > 0) { %>
    <div class="dashboard-section">
      <div class="section-header-sm">
        <h2>🔔 Notifications</h2>
      </div>
      <div class="notifications-list">
        <% notifications.forEach(n => { %>
          <div class="notification-item notification-<%= n.type %>">
            <span class="notif-icon"><%= n.type === 'success' ? '✅' : n.type === 'warning' ? '⚠️' : 'ℹ️' %></span>
            <div>
              <p><%= n.message %></p>
              <span class="notif-time"><%= new Date(n.createdAt).toLocaleDateString('en-IN', {day:'numeric',month:'short',hour:'2-digit',minute:'2-digit'}) %></span>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  <% } %>

  <!-- AI Recommendations -->
  <div class="dashboard-section">
    <div class="section-header-sm">
      <div>
        <h2>🤖 AI Recommended for You</h2>
        <p class="section-desc">Based on your interests: 
          <% if (currentUser.interests && currentUser.interests.length > 0) { %>
            <% currentUser.interests.forEach(i => { %><span class="interest-tag"><%= i %></span><% }) %>
          <% } else { %>
            <a href="/auth/profile" class="link-accent">Add your interests →</a>
          <% } %>
        </p>
      </div>
    </div>
    <% if (recommendedEvents.length === 0) { %>
      <div class="empty-state-sm">
        <p>🎯 <a href="/auth/profile">Add your interests</a> to get personalized recommendations!</p>
      </div>
    <% } else { %>
      <div class="events-grid">
        <% const catColors = {coding:'#6366f1',music:'#ec4899',dance:'#f59e0b',sports:'#10b981',art:'#8b5cf6',science:'#06b6d4',business:'#f97316',gaming:'#84cc16',photography:'#14b8a6',drama:'#ef4444',debate:'#3b82f6',literature:'#a78bfa',other:'#64748b'}; %>
        <% const catEmojis = {coding:'💻',music:'🎵',dance:'💃',sports:'⚽',art:'🎨',science:'🔬',business:'💼',gaming:'🎮',photography:'📸',drama:'🎭',debate:'🗣',literature:'📚',other:'🎯'}; %>
        <% recommendedEvents.forEach(event => { %>
          <article class="event-card">
            <div class="event-card-top" style="background:linear-gradient(135deg,<%= catColors[event.category]||'#6366f1' %>22,<%= catColors[event.category]||'#6366f1' %>44)">
              <div class="event-poster-placeholder"><span><%= catEmojis[event.category]||'🎯' %></span></div>
              <span class="event-category-badge" style="background:<%= catColors[event.category]||'#6366f1' %>"><%= event.category %></span>
              <span class="ai-rec-badge">🤖 AI Pick</span>
            </div>
            <div class="event-card-body">
              <h3 class="event-title"><a href="/events/<%= event._id %>"><%= event.title %></a></h3>
              <p class="event-desc"><%= event.description.substring(0, 80) %>...</p>
              <div class="event-meta">
                <span>📅 <%= new Date(event.date).toLocaleDateString('en-IN',{day:'numeric',month:'short'}) %></span>
                <span>📍 <%= event.venue.substring(0,20) %></span>
              </div>
              <div class="event-footer">
                <span class="reg-count"><%= event.registrationCount || 0 %> registered</span>
                <a href="/events/<%= event._id %>" class="btn-sm">Register →</a>
              </div>
            </div>
          </article>
        <% }) %>
      </div>
    <% } %>
  </div>

  <!-- Upcoming Registered Events -->
  <div class="dashboard-section">
    <div class="section-header-sm">
      <h2>📋 Your Upcoming Events</h2>
      <a href="/registrations/my" class="view-all-link">See All →</a>
    </div>
    <% if (myRegistrations.length === 0) { %>
      <div class="empty-state-sm">
        <p>You haven't registered for any upcoming events. <a href="/events">Browse events →</a></p>
      </div>
    <% } else { %>
      <div class="registrations-list">
        <% myRegistrations.forEach(reg => { %>
          <% if (reg.event) { %>
            <div class="registration-item">
              <div class="reg-item-color" style="background:<%= catColors[reg.event.category]||'#6366f1' %>"></div>
              <div class="reg-item-info">
                <strong><a href="/events/<%= reg.event._id %>"><%= reg.event.title %></a></strong>
                <div class="reg-item-meta">
                  <span>📅 <%= new Date(reg.event.date).toLocaleDateString('en-IN',{weekday:'short',day:'numeric',month:'short'}) %></span>
                  <span>⏰ <%= reg.event.time %></span>
                  <span>📍 <%= reg.event.venue %></span>
                </div>
              </div>
              <div class="reg-item-actions">
                <span class="reg-status-badge">✓ Registered</span>
                <form action="/registrations/<%= reg.event._id %>?_method=DELETE" method="POST">
                  <button type="submit" class="btn-xs btn-danger-outline" onclick="return confirm('Unregister from this event?')">Unregister</button>
                </form>
              </div>
            </div>
          <% } %>
        <% }) %>
      </div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
