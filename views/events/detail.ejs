<%- include('../partials/header') %>

<% const catColors = {coding:'#6366f1',music:'#ec4899',dance:'#f59e0b',sports:'#10b981',art:'#8b5cf6',science:'#06b6d4',business:'#f97316',gaming:'#84cc16',photography:'#14b8a6',drama:'#ef4444',debate:'#3b82f6',literature:'#a78bfa',workshop:'#f43f5e',seminar:'#0ea5e9',other:'#64748b'}; %>
<% const catEmojis = {coding:'💻',music:'🎵',dance:'💃',sports:'⚽',art:'🎨',science:'🔬',business:'💼',gaming:'🎮',photography:'📸',drama:'🎭',debate:'🗣',literature:'📚',workshop:'🛠',seminar:'📊',other:'🎯'}; %>
<% const color = catColors[event.category] || '#6366f1'; %>

<div class="page-container">
  <!-- Breadcrumb -->
  <div class="breadcrumb">
    <a href="/events">Events</a> <span>/</span> <span><%= event.title.substring(0,30) %><%= event.title.length > 30 ? '...' : '' %></span>
  </div>

  <div class="event-detail-grid">
    <!-- Main Content -->
    <div class="event-detail-main">
      <!-- Event Hero -->
      <div class="event-hero" style="background: linear-gradient(135deg, <%= color %>33, <%= color %>11);">
        <% if (event.poster) { %>
          <img src="<%= event.poster %>" alt="<%= event.title %>" class="event-hero-img" />
        <% } else { %>
          <div class="event-hero-placeholder">
            <span style="color:<%= color %>"><%= catEmojis[event.category] || '🎯' %></span>
          </div>
        <% } %>
      </div>

      <div class="event-detail-content">
        <div class="event-detail-badges">
          <span class="event-category-badge-lg" style="background:<%= color %>20;color:<%= color %>;border:1px solid <%= color %>44">
            <%= catEmojis[event.category] || '' %> <%= event.category %>
          </span>
          <% if (event.isPlacementRelated) { %>
            <span class="placement-badge-lg">🏢 Placement Event · <%= event.companyName %></span>
          <% } %>
          <% if (new Date(event.date) < new Date()) { %>
            <span class="status-badge past">Completed</span>
          <% } else { %>
            <span class="status-badge upcoming">Upcoming</span>
          <% } %>
        </div>

        <h1 class="event-detail-title"><%= event.title %></h1>

        <div class="event-detail-meta-row">
          <div class="meta-item">
            <span class="meta-icon">📅</span>
            <div>
              <strong>Date</strong>
              <span><%= new Date(event.date).toLocaleDateString('en-IN', {weekday:'long',day:'numeric',month:'long',year:'numeric'}) %></span>
            </div>
          </div>
          <div class="meta-item">
            <span class="meta-icon">⏰</span>
            <div>
              <strong>Time</strong>
              <span><%= event.time %></span>
            </div>
          </div>
          <div class="meta-item">
            <span class="meta-icon">📍</span>
            <div>
              <strong>Venue</strong>
              <span><%= event.venue %></span>
            </div>
          </div>
          <div class="meta-item">
            <span class="meta-icon">👥</span>
            <div>
              <strong>Capacity</strong>
              <span><%= registrationCount %> / <%= event.capacity %> registered</span>
            </div>
          </div>
        </div>

        <!-- Progress bar -->
        <div class="capacity-bar">
          <div class="capacity-fill" style="width:<%= Math.min((registrationCount/event.capacity)*100, 100) %>%;background:<%= color %>"></div>
        </div>
        <p class="capacity-text">
          <% const spotsLeft = event.capacity - registrationCount; %>
          <% if (spotsLeft <= 0) { %>
            <span class="text-danger">⚠ Event is full!</span>
          <% } else if (spotsLeft <= 10) { %>
            <span class="text-warning">⚡ Only <%= spotsLeft %> spots left!</span>
          <% } else { %>
            <span class="text-success"><%= spotsLeft %> spots available</span>
          <% } %>
        </p>

        <!-- Description -->
        <div class="event-description">
          <h2>About This Event</h2>
          <p><%= event.description %></p>
        </div>

        <% if (event.requirements) { %>
          <div class="event-requirements">
            <h3>📋 Requirements</h3>
            <p><%= event.requirements %></p>
          </div>
        <% } %>

        <% if (event.prizes) { %>
          <div class="event-prizes">
            <h3>🏆 Prizes</h3>
            <p><%= event.prizes %></p>
          </div>
        <% } %>

        <% if (event.isPlacementRelated) { %>
          <div class="placement-info-box">
            <h3>💼 Placement Details</h3>
            <div class="placement-details">
              <div><strong>Company:</strong> <%= event.companyName %></div>
              <% if (event.jobRole) { %><div><strong>Role:</strong> <%= event.jobRole %></div><% } %>
            </div>
          </div>
        <% } %>

        <!-- Tags -->
        <% if (event.tags && event.tags.length > 0) { %>
          <div class="event-tags-section">
            <h3>🏷 AI-Generated Tags</h3>
            <div class="event-tags">
              <% event.tags.forEach(tag => { %><span class="event-tag">#<%= tag %></span><% }) %>
            </div>
          </div>
        <% } %>

        <!-- Organizer -->
        <div class="organizer-section">
          <h3>👤 Organized by</h3>
          <div class="organizer-card">
            <div class="organizer-avatar"><%= (event.createdBy.clubName || event.createdBy.name).charAt(0) %></div>
            <div>
              <strong><%= event.createdBy.clubName || event.createdBy.name %></strong>
              <span><%= event.createdBy.role === 'club' ? 'Club' : 'Organizer' %></span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Sidebar -->
    <div class="event-detail-sidebar">
      <!-- Registration Card -->
      <div class="registration-card" style="border-top: 3px solid <%= color %>">
        <% if (event.isPaid) { %>
          <div class="event-fee"><span class="fee-amount">₹<%= event.fee %></span> <span>per person</span></div>
        <% } else { %>
          <div class="event-fee free">🎉 Free Event</div>
        <% } %>

        <% if (!currentUser) { %>
          <a href="/auth/login" class="btn-primary btn-full">Login to Register</a>
          <p class="reg-note">Create a free account to register</p>
        <% } else if (currentUser.role === 'student') { %>
          <% if (isRegistered) { %>
            <div class="registered-status">
              <span>✅ You're registered!</span>
            </div>
            <form action="/registrations/<%= event._id %>?_method=DELETE" method="POST">
              <button type="submit" class="btn-danger btn-full" onclick="return confirm('Unregister from this event?')">
                Unregister
              </button>
            </form>
          <% } else if (new Date(event.date) < new Date()) { %>
            <button class="btn-disabled btn-full" disabled>Event has ended</button>
          <% } else if (registrationCount >= event.capacity) { %>
            <button class="btn-disabled btn-full" disabled>⚠ Event Full</button>
          <% } else { %>
            <form action="/registrations/<%= event._id %>" method="POST">
              <button type="submit" class="btn-primary btn-full" style="background:<%= color %>">
                Register Now →
              </button>
            </form>
          <% } %>
        <% } else { %>
          <div class="club-note">You are managing this platform as a club/admin</div>
        <% } %>

        <div class="reg-stats">
          <div class="reg-stat">
            <strong><%= registrationCount %></strong>
            <span>Registered</span>
          </div>
          <div class="reg-stat">
            <strong><%= Math.max(0, event.capacity - registrationCount) %></strong>
            <span>Spots Left</span>
          </div>
          <div class="reg-stat">
            <strong><%= event.views %></strong>
            <span>Views</span>
          </div>
        </div>
      </div>

      <!-- Club Actions -->
      <% if (canEdit) { %>
        <div class="club-actions-card">
          <h3>⚙ Manage Event</h3>
          <a href="/events/<%= event._id %>/edit" class="btn-secondary btn-full">Edit Event</a>
          <a href="/club/events/<%= event._id %>/attendees" class="btn-secondary btn-full">View Attendees (<%= registrationCount %>)</a>
          <form action="/events/<%= event._id %>?_method=DELETE" method="POST">
            <button type="submit" class="btn-danger btn-full" onclick="return confirm('Are you sure you want to delete this event? This cannot be undone.')">
              🗑 Delete Event
            </button>
          </form>
        </div>
      <% } %>

      <!-- Similar Events -->
      <% if (similarEvents.length > 0) { %>
        <div class="similar-events-card">
          <h3>🔗 Similar Events</h3>
          <% similarEvents.forEach(se => { %>
            <a href="/events/<%= se._id %>" class="similar-event-item">
              <div class="similar-event-info">
                <strong><%= se.title.substring(0,35) %><%= se.title.length > 35 ? '...' : '' %></strong>
                <span>📅 <%= new Date(se.date).toLocaleDateString('en-IN', {day:'numeric',month:'short'}) %></span>
              </div>
              <span>→</span>
            </a>
          <% }) %>
        </div>
      <% } %>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
