<%- include('../partials/header') %>

<div class="page-container">
  <div class="page-header">
    <div>
      <h1 class="page-title">Create New Event</h1>
      <p class="page-subtitle">🤖 AI will auto-detect category & generate tags from your description</p>
    </div>
  </div>

  <div class="form-page-grid">
    <div class="form-main">
      <form action="/events/create" method="POST" enctype="multipart/form-data" class="event-form" id="eventForm">

        <!-- Basic Info -->
        <div class="form-section">
          <h2 class="form-section-title">📝 Basic Information</h2>
          <div class="form-group">
            <label for="title">Event Title *</label>
            <input type="text" id="title" name="title" class="form-input" placeholder="e.g. HackVerse 2024 - 36 Hour Hackathon" required />
          </div>
          <div class="form-group">
            <label for="description">
              Description *
              <span class="ai-label">🤖 AI reads this to auto-tag your event</span>
            </label>
            <textarea id="description" name="description" class="form-input form-textarea-lg" placeholder="Describe your event in detail. Include what it's about, who should attend, activities planned..." required rows="5"></textarea>
          </div>

          <!-- AI Preview -->
          <div class="ai-preview-box" id="aiPreview" style="display:none">
            <div class="ai-preview-header">🤖 AI Analysis Preview</div>
            <div class="ai-preview-content">
              <div>Detected Category: <strong id="aiCategory">-</strong></div>
              <div>Auto Tags: <span id="aiTags">-</span></div>
            </div>
          </div>
        </div>

        <!-- Date & Venue -->
        <div class="form-section">
          <h2 class="form-section-title">📅 When & Where</h2>
          <div class="form-row">
            <div class="form-group">
              <label for="date">Event Date *</label>
              <input type="date" id="date" name="date" class="form-input" required min="<%= new Date().toISOString().split('T')[0] %>" />
            </div>
            <div class="form-group">
              <label for="time">Event Time *</label>
              <input type="time" id="time" name="time" class="form-input" required />
            </div>
          </div>
          <div class="form-group">
            <label for="venue">Venue *</label>
            <input type="text" id="venue" name="venue" class="form-input" placeholder="e.g. Main Auditorium, Block C, Room 201" required />
          </div>
          <div class="form-group">
            <label for="registrationDeadline">Registration Deadline <span class="optional">(optional)</span></label>
            <input type="date" id="registrationDeadline" name="registrationDeadline" class="form-input" />
          </div>
        </div>

        <!-- Category & Capacity -->
        <div class="form-section">
          <h2 class="form-section-title">⚙ Event Details</h2>
          <div class="form-row">
            <div class="form-group">
              <label for="category">Category <span class="ai-label">🤖 or let AI detect</span></label>
              <select id="category" name="category" class="form-input">
                <option value="">🤖 Auto-detect from description</option>
                <% categories.forEach(cat => { %>
                  <option value="<%= cat %>"><%= cat.charAt(0).toUpperCase() + cat.slice(1) %></option>
                <% }) %>
              </select>
            </div>
            <div class="form-group">
              <label for="capacity">Max Capacity *</label>
              <input type="number" id="capacity" name="capacity" class="form-input" value="100" min="1" required />
            </div>
          </div>
          <div class="form-group">
            <label for="requirements">Requirements <span class="optional">(optional)</span></label>
            <input type="text" id="requirements" name="requirements" class="form-input" placeholder="e.g. Laptop required, Team of 2-4 members" />
          </div>
          <div class="form-group">
            <label for="prizes">Prizes / Benefits <span class="optional">(optional)</span></label>
            <input type="text" id="prizes" name="prizes" class="form-input" placeholder="e.g. 1st: ₹10,000 | 2nd: ₹5,000" />
          </div>
        </div>

        <!-- Registration Fee -->
        <div class="form-section">
          <h2 class="form-section-title">💰 Registration Fee</h2>
          <div class="form-toggle-group">
            <label class="toggle-switch">
              <input type="checkbox" name="isPaid" id="isPaid" onchange="toggleFee(this)" />
              <span class="toggle-slider"></span>
              <span>Paid Event</span>
            </label>
          </div>
          <div id="feeField" style="display:none" class="form-group" style="margin-top:1rem">
            <label for="fee">Registration Fee (₹)</label>
            <input type="number" id="fee" name="fee" class="form-input" placeholder="0" min="0" />
          </div>
        </div>

        <!-- Placement Section -->
        <div class="form-section">
          <h2 class="form-section-title">🏢 Placement / Company Event</h2>
          <div class="form-toggle-group">
            <label class="toggle-switch">
              <input type="checkbox" name="isPlacementRelated" id="isPlacementRelated" onchange="togglePlacement(this)" />
              <span class="toggle-slider"></span>
              <span>This is a placement / company event</span>
            </label>
          </div>
          <div id="placementFields" style="display:none">
            <div class="form-row" style="margin-top:1rem">
              <div class="form-group">
                <label for="companyName">Company Name</label>
                <input type="text" id="companyName" name="companyName" class="form-input" placeholder="e.g. Google, Infosys" />
              </div>
              <div class="form-group">
                <label for="jobRole">Job Role</label>
                <input type="text" id="jobRole" name="jobRole" class="form-input" placeholder="e.g. Software Engineer" />
              </div>
            </div>
          </div>
        </div>

        <!-- Poster Upload -->
        <div class="form-section">
          <h2 class="form-section-title">🖼 Event Poster</h2>
          <div class="file-upload-area" id="uploadArea">
            <input type="file" id="poster" name="poster" accept="image/*" class="file-input" onchange="previewImage(this)" />
            <div class="file-upload-placeholder" id="uploadPlaceholder">
              <span class="upload-icon">📤</span>
              <p>Click or drag to upload event poster</p>
              <span class="upload-hint">PNG, JPG up to 5MB</span>
            </div>
            <img id="posterPreview" class="poster-preview" style="display:none" />
          </div>
        </div>

        <div class="form-actions">
          <a href="/dashboard" class="btn-secondary">Cancel</a>
          <button type="submit" class="btn-primary">🚀 Create Event</button>
        </div>
      </form>
    </div>

    <!-- Tips Sidebar -->
    <div class="form-sidebar">
      <div class="tips-card">
        <h3>🤖 AI Features</h3>
        <div class="tip-item">
          <strong>Auto Category Detection</strong>
          <p>Leave category empty and AI will detect it from your description using keyword analysis.</p>
        </div>
        <div class="tip-item">
          <strong>Smart Tagging</strong>
          <p>AI extracts relevant tags from your title and description automatically.</p>
        </div>
        <div class="tip-item">
          <strong>Student Notifications</strong>
          <p>Students with matching interests are automatically notified when you create an event!</p>
        </div>
      </div>
      <div class="tips-card">
        <h3>💡 Tips for Better Events</h3>
        <div class="tip-item"><p>✓ Write a detailed description (100+ words) for better AI tagging</p></div>
        <div class="tip-item"><p>✓ Add a high-quality event poster to attract more students</p></div>
        <div class="tip-item"><p>✓ Mention prizes and requirements to set clear expectations</p></div>
        <div class="tip-item"><p>✓ Set a registration deadline to create urgency</p></div>
      </div>
    </div>
  </div>
</div>

<script>
function toggleFee(cb) {
  document.getElementById('feeField').style.display = cb.checked ? 'block' : 'none';
}
function togglePlacement(cb) {
  document.getElementById('placementFields').style.display = cb.checked ? 'block' : 'none';
}
function previewImage(input) {
  if (input.files && input.files[0]) {
    const reader = new FileReader();
    reader.onload = e => {
      const preview = document.getElementById('posterPreview');
      document.getElementById('uploadPlaceholder').style.display = 'none';
      preview.src = e.target.result;
      preview.style.display = 'block';
    };
    reader.readAsDataURL(input.files[0]);
  }
}

// AI Preview on description change
let aiTimeout;
document.getElementById('description').addEventListener('input', function() {
  clearTimeout(aiTimeout);
  const title = document.getElementById('title').value;
  const desc = this.value;
  if (desc.length < 20) return;
  aiTimeout = setTimeout(async () => {
    try {
      const res = await fetch('/api/detect-category', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ title, description: desc })
      });
      const data = await res.json();
      document.getElementById('aiPreview').style.display = 'block';
      document.getElementById('aiCategory').textContent = data.category;
      document.getElementById('aiTags').textContent = data.tags.slice(0,5).map(t => '#' + t).join(' ');
    } catch(e) {}
  }, 800);
});
</script>

<%- include('../partials/footer') %>
