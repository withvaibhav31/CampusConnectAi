<%- include('../partials/header') %>

<div class="page-container">
  <!-- Page Header -->
  <div class="page-header">
    <div>
      <h1 class="page-title">All Events</h1>
      <p class="page-subtitle">Discover everything happening on campus</p>
    </div>
    <% if (currentUser && (currentUser.role === 'club' || currentUser.role === 'admin')) { %>
      <a href="/events/create" class="btn-primary">+ Create Event</a>
    <% } %>
  </div>

  <!-- Filters -->
  <div class="filters-bar">
    <form method="GET" action="/events" class="filters-form" id="filterForm">
      <!-- Search -->
      <div class="search-box">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        <input type="text" name="search" placeholder="Search events..." class="search-input" value="<%= searchQuery %>" />
      </div>

      <!-- Category Filter -->
      <div class="filter-group">
        <select name="category" class="filter-select" onchange="document.getElementById('filterForm').submit()">
          <option value="all" <%= currentCategory === 'all' ? 'selected' : '' %>>All Categories</option>
          <% categories.forEach(cat => { %>
            <option value="<%= cat %>" <%= currentCategory === cat ? 'selected' : '' %>>
              <%= cat.charAt(0).toUpperCase() + cat.slice(1) %>
            </option>
          <% }) %>
        </select>
      </div>

      <!-- Status Filter -->
      <div class="filter-group">
        <select name="status" class="filter-select" onchange="document.getElementById('filterForm').submit()">
          <option value="upcoming" <%= currentStatus === 'upcoming' ? 'selected' : '' %>>Upcoming</option>
          <option value="past" <%= currentStatus === 'past' ? 'selected' : '' %>>Past Events</option>
          <option value="all" <%= currentStatus === 'all' ? 'selected' : '' %>>All Events</option>
        </select>
      </div>

      <!-- Sort -->
      <div class="filter-group">
        <select name="sort" class="filter-select" onchange="document.getElementById('filterForm').submit()">
          <option value="date" <%= currentSort === 'date' ? 'selected' : '' %>>Soonest First</option>
          <option value="newest" <%= currentSort === 'newest' ? 'selected' : '' %>>Newest</option>
          <option value="popular" <%= currentSort === 'popular' ? 'selected' : '' %>>Most Viewed</option>
        </select>
      </div>

      <button type="submit" class="btn-filter">Search</button>
      <% if (searchQuery || currentCategory !== 'all') { %>
        <a href="/events" class="btn-clear">Clear</a>
      <% } %>
    </form>
  </div>

  <!-- Results Info -->
  <div class="results-info">
    <span><strong><%= events.length %></strong> events found
      <% if (currentCategory !== 'all') { %> in <strong><%= currentCategory %></strong><% } %>
    </span>
  </div>

  <!-- Events Grid -->
  <% if (events.length === 0) { %>
    <div class="empty-state">
      <span class="empty-icon">🔍</span>
      <h3>No events found</h3>
      <p>Try a different category or search term</p>
      <a href="/events" class="btn-secondary">Clear Filters</a>
    </div>
  <% } else { %>
    <div class="events-grid events-grid-full">
      <% const catColors = {coding:'#6366f1',music:'#ec4899',dance:'#f59e0b',sports:'#10b981',art:'#8b5cf6',science:'#06b6d4',business:'#f97316',gaming:'#84cc16',photography:'#14b8a6',drama:'#ef4444',debate:'#3b82f6',literature:'#a78bfa',workshop:'#f43f5e',seminar:'#0ea5e9',other:'#64748b'}; %>
      <% const catEmojis = {coding:'💻',music:'🎵',dance:'💃',sports:'⚽',art:'🎨',science:'🔬',business:'💼',gaming:'🎮',photography:'📸',drama:'🎭',debate:'🗣',literature:'📚',workshop:'🛠',seminar:'📊',other:'🎯'}; %>
      <% events.forEach(event => { %>
        <article class="event-card">
          <div class="event-card-top" style="background: linear-gradient(135deg, <%= catColors[event.category] || '#6366f1' %>22, <%= catColors[event.category] || '#6366f1' %>44);">
            <% if (event.poster) { %>
              <img src="<%= event.poster %>" alt="<%= event.title %>" class="event-poster-img" />
            <% } else { %>
              <div class="event-poster-placeholder">
                <span><%= catEmojis[event.category] || '🎯' %></span>
              </div>
            <% } %>
            <span class="event-category-badge" style="background:<%= catColors[event.category] || '#6366f1' %>">
              <%= event.category %>
            </span>
            <% if (event.isPlacementRelated) { %><span class="placement-badge">🏢 Placement</span><% } %>
            <% if (event.isRegistered) { %><span class="registered-badge">✓ Registered</span><% } %>
            <% if (new Date(event.date) < new Date()) { %><span class="past-badge">Completed</span><% } %>
          </div>
          <div class="event-card-body">
            <h3 class="event-title">
              <a href="/events/<%= event._id %>"><%= event.title %></a>
            </h3>
            <p class="event-desc"><%= event.description.substring(0, 90) %>...</p>
            <div class="event-meta">
              <span>📅 <%= new Date(event.date).toLocaleDateString('en-IN', {day:'numeric',month:'short'}) %></span>
              <span>⏰ <%= event.time %></span>
              <span>📍 <%= event.venue.substring(0,20) %><%= event.venue.length > 20 ? '...' : '' %></span>
            </div>
            <% if (event.tags && event.tags.length > 0) { %>
              <div class="event-tags">
                <% event.tags.slice(0,3).forEach(tag => { %><span class="event-tag">#<%= tag %></span><% }) %>
              </div>
            <% } %>
            <div class="event-footer">
              <div class="event-footer-left">
                <span class="reg-count"><%= event.registrationCount %> / <%= event.capacity %></span>
                <% if (event.isPaid) { %><span class="fee-badge">₹<%= event.fee %></span><% } else { %><span class="free-badge">Free</span><% } %>
              </div>
              <a href="/events/<%= event._id %>" class="btn-sm">Details →</a>
            </div>
          </div>
        </article>
      <% }) %>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
