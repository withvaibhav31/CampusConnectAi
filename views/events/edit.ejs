<%- include('../partials/header') %>

<div class="page-container">
  <div class="page-header">
    <div>
      <h1 class="page-title">Edit Event</h1>
      <p class="page-subtitle">Update event details</p>
    </div>
    <a href="/events/<%= event._id %>" class="btn-secondary">← Back to Event</a>
  </div>

  <div class="form-page-grid">
    <div class="form-main">
      <form action="/events/<%= event._id %>?_method=PUT" method="POST" class="event-form">
        <div class="form-section">
          <h2 class="form-section-title">📝 Basic Information</h2>
          <div class="form-group">
            <label for="title">Event Title *</label>
            <input type="text" id="title" name="title" class="form-input" value="<%= event.title %>" required />
          </div>
          <div class="form-group">
            <label for="description">Description *</label>
            <textarea id="description" name="description" class="form-input form-textarea-lg" required rows="5"><%= event.description %></textarea>
          </div>
        </div>

        <div class="form-section">
          <h2 class="form-section-title">📅 When & Where</h2>
          <div class="form-row">
            <div class="form-group">
              <label for="date">Event Date *</label>
              <input type="date" id="date" name="date" class="form-input" value="<%= new Date(event.date).toISOString().split('T')[0] %>" required />
            </div>
            <div class="form-group">
              <label for="time">Event Time *</label>
              <input type="time" id="time" name="time" class="form-input" value="<%= event.time %>" required />
            </div>
          </div>
          <div class="form-group">
            <label for="venue">Venue *</label>
            <input type="text" id="venue" name="venue" class="form-input" value="<%= event.venue %>" required />
          </div>
        </div>

        <div class="form-section">
          <h2 class="form-section-title">⚙ Event Details</h2>
          <div class="form-row">
            <div class="form-group">
              <label for="category">Category</label>
              <select id="category" name="category" class="form-input">
                <% categories.forEach(cat => { %>
                  <option value="<%= cat %>" <%= event.category === cat ? 'selected' : '' %>><%= cat.charAt(0).toUpperCase() + cat.slice(1) %></option>
                <% }) %>
              </select>
            </div>
            <div class="form-group">
              <label for="capacity">Max Capacity</label>
              <input type="number" id="capacity" name="capacity" class="form-input" value="<%= event.capacity %>" min="1" />
            </div>
          </div>
          <div class="form-group">
            <label for="status">Status</label>
            <select id="status" name="status" class="form-input">
              <option value="upcoming" <%= event.status === 'upcoming' ? 'selected' : '' %>>Upcoming</option>
              <option value="ongoing" <%= event.status === 'ongoing' ? 'selected' : '' %>>Ongoing</option>
              <option value="completed" <%= event.status === 'completed' ? 'selected' : '' %>>Completed</option>
              <option value="cancelled" <%= event.status === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
            </select>
          </div>
        </div>

        <div class="form-actions">
          <a href="/events/<%= event._id %>" class="btn-secondary">Cancel</a>
          <button type="submit" class="btn-primary">💾 Save Changes</button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
